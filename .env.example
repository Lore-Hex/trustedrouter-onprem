# Managed hosted backend. Create a key at https://trustedrouter.com/console/keys.
TRUSTEDROUTER_API_KEY=

# Optional customer-controlled direct provider connections.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional cloud BYOK connections.
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Optional model optimization and sandbox services.
TINKER_API_KEY=
E2B_API_KEY=

# Optional local or private-network OpenAI-compatible endpoint.
TRUSTEDROUTER_ONPREM_ENDPOINT_API_KEY=
TRUSTEDROUTER_ONPREM_ENDPOINT_BASE_URL=http://127.0.0.1:8080/v1
